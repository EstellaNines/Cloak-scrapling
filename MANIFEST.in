include README.md
include README.en.md
include LICENSE
include pyproject.toml
include src/cloak_scrapling/py.typed
recursive-include src/cloak_scrapling/agent_skill *.md
recursive-include docs *.md *.svg
recursive-include scripts *.py *.ps1
recursive-include vendor_browser *

prune .cloakbrowser-cache
prune .logs
prune build
prune dist
prune .venv

global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude *.pyo
global-exclude *.egg-info/*
